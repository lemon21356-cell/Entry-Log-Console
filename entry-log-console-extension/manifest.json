{
  "manifest_version": 3,
  "name": "Entry Log Console",
  "description": "엔트리 말하기 블록에 로그 레벨을 추가하고 아래 출력 패널에 기록합니다.",
  "version": "1.0.0",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    },
    "default_title": "Entry Log Console"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*",
        "https://www.playentry.org/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "icon.png"
      ],
      "matches": [
        "https://playentry.org/*",
        "https://www.playentry.org/*"
      ]
    }
  ]
}
